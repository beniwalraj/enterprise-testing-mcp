{
  "mcpServers": {
    "enterprise-testing-mcp": {
      "command": "npx",
      "args": ["tsx", "/absolute/path/to/your/enterprise-testing-mcp/src/index.ts"]
    },
    "playwright-automation": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-playwright"]
    },
    "postgres-db-inspector": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "--connection-string", "postgresql://localhost:5432/staging_db"]
    }
  }
}
